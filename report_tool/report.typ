#let data = json("firmware-data.json")
#let ink = rgb("172D40")
#let muted = rgb("667987")
#let teal = rgb("087F83")
#let pale = rgb("EDF5F4")
#let border = rgb("DFE7EB")
#let logo = ""
#let rows = ()
#for record in data.records {
  if not rows.any(r => r.brand == record.brand and r.dev == record.dev and r.target == record.target_bl_version_number) {
    let matches = data.records.filter(r => r.brand == record.brand and r.dev == record.dev and r.target_bl_version_number == record.target_bl_version_number)
    let full = matches.any(r => r.upgrade_or_erec == "recovery")
    let name = record.display_model_name.replace("（参考）", "").replace("华为", "")
    if name == "商品名待核实" or name == "-" or name == "—" { name = "未收录机型" }
    let overseas = matches.any(r => r.vendor.contains("spcseas") or r.vendor.contains("specseas"))
    rows.push((
      brand: record.brand,
      dev: record.dev,
      target: record.target_bl_version_number,
      version: record.target_bl_version_number.split(" ").last(),
      name: name,
      overseas: overseas,
      action: if full { "全量" } else { "差分" },
    ))
  }
}
#let pages = if rows.len() == 0 { ((),) } else { rows.chunks(30) }

#set document(title: "HarmonyOS 固件更新日报", author: "FirmwareFetcher")
#let side = calc.max(230, 230 + (calc.min(rows.len(), 30) - 26) * 6 + calc.max(0, data.system_summary.len() - 2) * 6) * 1mm
#set page(
  width: side,
  height: side,
  margin: (x: 12mm, top: 12mm, bottom: 30mm),
  footer-descent: 0mm,
  footer: grid(
    columns: (1fr, 20mm),
    column-gutter: 5mm,
    align: (left + bottom, right + bottom),
    text(size: 10pt, fill: muted)[以上信息来自互联网收集],
    image(bytes("<svg xmlns='http://www.w3.org/2000/svg' width='946' height='946'><image width='946' height='946' href='data:image/png;base64," + logo + "'/></svg>"), width: 20mm),
  ),
)
#set text(font: "Yozai", size: 10.5pt, fill: ink, lang: "zh")
#set par(leading: 2pt, spacing: 4pt)

#for (index, page-rows) in pages.enumerate() {
  if index > 0 { pagebreak() }
  grid(columns: (1fr, auto), align: bottom,
    [#text(size: 26pt, weight: "bold")[HarmonyOS 固件更新日报]],
    [#text(size: 17pt, fill: teal)[#data.report_date.replace("-", ".")]],
  )
  if index == 0 {
    v(8pt)
    table(
      columns: (1.8fr, 1fr, 1fr, 1fr),
      align: (left, center, center, center),
      inset: (x: 10pt, y: 5pt),
      stroke: (top: none, left: none, right: none, bottom: 0.4pt + border),
      fill: (x, y) => if y == 0 { ink } else { pale },
      table.header(
        text(fill: white, weight: "bold")[目标系统],
        text(fill: white, weight: "bold")[全量],
        text(fill: white, weight: "bold")[差分],
        text(fill: white, weight: "bold")[合计],
      ),
      ..data.system_summary.map(s => (
        [#s.label], [#s.full], [#s.delta], [#(s.full + s.delta)],
      )).flatten(),
      [*合计*], [*#data.counts.full*], [*#data.counts.delta*], [*#data.counts.firmware_records*],
    )
  }
  v(9pt)
  grid(columns: (1fr, auto),
    text(size: 12pt, weight: "bold")[机型与版本],
    if pages.len() > 1 { text(size: 9pt, fill: muted)[#(index + 1) / #pages.len()] },
  )
  v(5pt)
  table(
    columns: (175pt, 92pt, 1fr, 62pt),
    inset: (x: 5pt, y: 2.5pt),
    stroke: (top: none, left: none, right: none, bottom: 0.35pt + border),
    fill: (x, y) => if y == 0 { ink } else if calc.odd(y) { rgb("F4F7F8") } else { none },
    table.header(
      text(fill: white, weight: "bold")[机型],
      text(fill: white, weight: "bold")[设备代码],
      text(fill: white, weight: "bold")[目标版本],
      text(fill: white, weight: "bold")[包型],
    ),
    ..page-rows.map(r => (
      [#text(size: 11.5pt, weight: "medium")[#r.name]#if r.overseas { text(size: 10pt, fill: teal)[ · 海外] }],
      text(size: 10.5pt, fill: muted, r.dev),
      text(size: 10.5pt, r.version),
      text(size: 11pt, fill: if r.action == "全量" { rgb("2563EB") } else { ink }, r.action),
    )).flatten(),
  )
  if rows.len() == 0 { align(center)[当日暂无新入库固件] }
}
#context [#metadata((pages: counter(page).final().first(), rows: rows.len())) <report-layout>]
